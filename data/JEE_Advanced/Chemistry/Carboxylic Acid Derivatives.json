        "id": "8SnAy",
        "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_advanced/709d48b4-b6f8-42dd-bea6-b5792411daaf.png\" style=\"width: 350px; height: 160px;\" />",
