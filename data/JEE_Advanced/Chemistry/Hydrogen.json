    "solution_text": "(i)&nbsp; <math><mtext>Z</mtext><mtext>n</mtext><mo>+</mo><mn>2</mn><mtext>N</mtext><mtext>a</mtext><mtext>O</mtext><mtext>H</mtext><mo>→</mo><mtext>N</mtext><msub><mrow><mtext>a</mtext></mrow><mrow><mn>2</mn></mrow></msub><mtext>Z</mtext><mtext>n</mtext><msub><mrow><mtext>O</mtext></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msub><mrow><mtext>H</mtext></mrow><mrow><mn>2</mn></mrow></msub></math><br />(ii)&nbsp;<math><mn>4</mn><mtext>A</mtext><mtext>u</mtext><mo>+</mo><mn>8</mn><mtext>N</mtext><mtext>a</mtext><mtext>C</mtext><mtext>N</mtext><mo>+</mo><msub><mrow><mtext>O</mtext></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>2</mn><msub><mrow><mtext>H</mtext></mrow><mrow><mn>2</mn></mrow></msub><mtext>O</mtext><mo>→</mo><mn>4</mn><mtext>N</mtext><mtext>a</mtext><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtext>A</mtext><mtext>u</mtext><msub><mrow><mfenced separators=\"|\"><mrow><mtext>C</mtext><mtext>N</mtext></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>+&nbsp;</mo><mn>4</mn><mtext>N</mtext><mtext>a</mtext><mtext>O</mtext><mtext>H</mtext></math><br />(iii)&nbsp; <math> <mrow> <mtable> <mtr> <mtd> <mtext>C</mtext><mo>⁡</mo> <mtext>u</mtext><mo>⁡</mo> </mtd> <mtd> <mo>+</mo> </mtd> <mtd> <mn>4</mn> <mtext>H</mtext><mo>⁡</mo> <mtext>N</mtext><mo>⁡</mo> <msub> <mrow> <mtext>O</mtext><mo>⁡</mo> </mrow> <mn>3</mn> </msub> </mtd> <mtd> <mo>→</mo> </mtd> <mtd> <mtext>C</mtext><mo>⁡</mo> <mtext>u</mtext><mo>⁡</mo> <msub> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>N</mtext><mo>⁡</mo> <msub> <mrow> <mtext>O</mtext><mo>⁡</mo> </mrow> <mn>3</mn> </msub> </mrow> </mfenced> </mrow> <mn>2</mn> </msub> </mtd> <mtd> <mo>+</mo> </mtd> <mtd> <mn>2</mn> <mtext>N</mtext><mo>⁡</mo> <msub> <mrow> <mtext>O</mtext><mo>⁡</mo> </mrow> <mn>2</mn> </msub> </mtd> <mtd> <mo>+</mo>&nbsp;<mn>&nbsp;2</mn> <msub> <mrow> <mtext>H</mtext><mo>⁡</mo> </mrow> <mn>2</mn> </msub> <mtext>O</mtext><mo>⁡</mo> </mtd> <mtd> </mtd> </mtr> <mtr> <mtd> </mtd> <mtd> </mtd> <mtd> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>conc.</mtext> </mrow> </mfenced> </mtd> <mtd> </mtd> <mtd> </mtd> <mtd> </mtd> <mtd> </mtd> <mtd> </mtd> <mtd> </mtd> </mtr> </mtable> </mrow> </math><br />(iv)&nbsp;Formation of passive layer of&nbsp;<math><mtext>F</mtext><msub><mrow><mtext>e</mtext></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mtext>O</mtext></mrow><mrow><mn>3</mn></mrow></msub></math>&nbsp;on the surface of Fe and&nbsp;<math><mtext>N</mtext><msub><mrow><mtext>O</mtext></mrow><mrow><mn>2</mn></mrow></msub></math>&nbsp;gas is evolved.<br /><math> <mrow> <mtext>F</mtext><mtext>e</mtext><mo>+</mo><mn>4</mn><mtext>H</mtext><mtext>N</mtext><msub> <mtext>O</mtext> <mn>3</mn> </msub> <mo>→</mo><mtext>F</mtext><mtext>e</mtext><msub> <mrow> <mrow><mo>(</mo> <mrow> <mtext>N</mtext><msub> <mtext>O</mtext> <mn>3</mn> </msub> </mrow> <mo>)</mo></mrow></mrow> <mn>3</mn> </msub> <mo>+</mo><mtext>N</mtext><msub> <mtext>O</mtext> <mn>2</mn> </msub> <mo>+</mo><mfrac> <mn>1</mn> <mn>2</mn> </mfrac> <msub> <mtext>O</mtext> <mn>2</mn> </msub> </mrow> </math>",
