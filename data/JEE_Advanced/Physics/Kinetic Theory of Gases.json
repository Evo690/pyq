riant=\"normal\">n</mi><mi mathvariant=\"normal\">d</mi></mrow></msub></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">e</mi></mrow></msub></mrow><mrow><msub><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">d</mi></mrow></msub></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">H</mi><mi mathvariant=\"normal\">e</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msqrt><mfrac><mrow><mi mathvariant=\"normal\">R</mi><mi mathvariant=\"normal\">T</mi></mrow><mrow><mn>2</mn></mrow></mfrac></msqrt></mrow><mrow><msqrt><mfrac><mrow><mn>5</mn><mi mathvariant=\"normal\">R</mi><mi mathvariant=\"normal\">T</mi></mrow><mrow><mn>12</mn></mrow></mfrac></msqrt></mrow></mfrac><mo>=</mo><msqrt><mfrac><mrow><mn>6</mn></mrow><mrow><mn>5</mn></mrow></mfrac></msqrt></math> <br > <math><mfrac><mrow><msub><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi></mrow></msub></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">H</mi><mi mathvariant=\"normal\">e</mi></mrow></msub></mrow><mrow><msub><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></mrow></msub></mrow></mfenced></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msqrt><mfrac><mrow><mn>3</mn><mi mathvariant=\"normal\">R</mi><mi mathvariant=\"normal\">T</mi></mrow><mro